{
  "project": {
    "name": "内部管理系统",
    "root": "../target-project",
    "zentao_product": "DTS",
    "tech_stack": {
      "framework": "Vue 2",
      "language": "JavaScript",
      "ui_library": "Element UI",
      "build_tool": "webpack"
    },
    "directories": {
      "src": "src/",
      "views": "src/views/",
      "components": "src/components/",
      "api": "src/api/"
    },
    "conventions": {
      "indent": 2,
      "quotes": "single",
      "semicolon": true
    }
  },
  "pipeline": {
    "runs_dir": "runs",
    "worktree_dir": "runs",
    "max_retries": 3,
    "command_timeout_seconds": 1200,
    "work_log": {
      "enabled": true
    },
    "commands": {
      "lint": "npm run lint",
      "test": "npm run test",
      "build": "npm run build"
    },
    "browser": {
      "enabled": false,
      "start_command": "npm run serve",
      "base_url": "http://127.0.0.1:8080",
      "environment": {"HOST": "127.0.0.1", "PORT": "8080"},
      "startup_timeout_seconds": 120,
      "action_timeout_seconds": 15,
      "headless": true,
      "screenshots": "on_failure",
      "scenarios": [
        {
          "name": "首页基本交互",
          "path": "/",
          "actions": [
            {"action": "click", "selector": "text=登录"},
            {"action": "expect_visible", "selector": ".login-form"}
          ]
        }
      ]
    }
  },
  "providers": {
    "requirement": {
      "type": "zentao",
      "config_file": "~/.zentao.json",
      "timeout_seconds": 30
    },
    "analysis": {
      "type": "kimi",
      "command": "kimi",
      "model": null,
      "timeout_seconds": 600
    },
    "development": {
      "type": "claude",
      "command": "claude",
      "model": "sonnet",
      "timeout_seconds": 900
    },
    "review": {
      "type": "codex",
      "command": "codex",
      "model": null,
      "timeout_seconds": 600
    }
  }
}
