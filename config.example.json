{
  "project": {
    "name": "内部管理系统",
    "root": "../target-project",
    "tech_stack": {
      "framework": "Vue 2",
      "language": "JavaScript",
      "ui_library": "Element UI",
      "build_tool": "webpack"
    },
    "directories": {
      "src": "src/",
      "views": "src/views/",
      "components": "src/components/",
      "api": "src/api/"
    },
    "conventions": {
      "indent": 2,
      "quotes": "single",
      "semicolon": true
    }
  },
  "pipeline": {
    "runs_dir": "runs",
    "worktree_dir": "runs",
    "max_retries": 1,
    "command_timeout_seconds": 1200,
    "commands": {
      "lint": "npm run lint",
      "test": "npm run test",
      "build": "npm run build"
    }
  },
  "providers": {
    "requirement": {
      "type": "zentao",
      "config_file": "~/.zentao.json",
      "timeout_seconds": 30
    },
    "analysis": {
      "type": "kimi",
      "command": "kimi",
      "model": null,
      "timeout_seconds": 600
    },
    "development": {
      "type": "claude",
      "command": "claude",
      "model": "sonnet",
      "timeout_seconds": 900
    },
    "review": {
      "type": "codex",
      "command": "codex",
      "model": null,
      "timeout_seconds": 600
    }
  }
}
